<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Display area -->
    <LinearLayout
        android:id="@+id/displayArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/buttonGrid"
        app:layout_constraintHeight_percent="0.32">

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="22sp"
            android:gravity="end"
            android:maxLines="2"
            android:ellipsize="start" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/text_primary"
            android:textSize="56sp"
            android:fontFamily="sans-serif-light"
            android:gravity="end"
            android:maxLines="1"
            android:adjustViewBounds="true"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="28sp"
            android:autoSizeMaxTextSize="56sp" />

    </LinearLayout>

    <!-- Button grid -->
    <GridLayout
        android:id="@+id/buttonGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="4"
        android:rowCount="5"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.68">

        <!-- Row 1: C, +/-, %, ÷ -->
        <Button
            android:id="@+id/btnClear"
            style="@style/BtnFunction"
            android:text="C"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <Button
            android:id="@+id/btnPlusMinus"
            style="@style/BtnFunction"
            android:text="+/−"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <Button
            android:id="@+id/btnPercent"
            style="@style/BtnFunction"
            android:text="%"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <Button
            android:id="@+id/btnDivide"
            style="@style/BtnOperator"
            android:text="÷"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <!-- Row 2: 7, 8, 9, × -->
        <Button
            android:id="@+id/btn7"
            style="@style/BtnNumber"
            android:text="7"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <Button
            android:id="@+id/btn8"
            style="@style/BtnNumber"
            android:text="8"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <Button
            android:id="@+id/btn9"
            style="@style/BtnNumber"
            android:text="9"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <Button
            android:id="@+id/btnMultiply"
            style="@style/BtnOperator"
            android:text="×"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <!-- Row 3: 4, 5, 6, − -->
        <Button
            android:id="@+id/btn4"
            style="@style/BtnNumber"
            android:text="4"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <Button
            android:id="@+id/btn5"
            style="@style/BtnNumber"
            android:text="5"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <Button
            android:id="@+id/btn6"
            style="@style/BtnNumber"
            android:text="6"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <Button
            android:id="@+id/btnSubtract"
            style="@style/BtnOperator"
            android:text="−"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <!-- Row 4: 1, 2, 3, + -->
        <Button
            android:id="@+id/btn1"
            style="@style/BtnNumber"
            android:text="1"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <Button
            android:id="@+id/btn2"
            style="@style/BtnNumber"
            android:text="2"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <Button
            android:id="@+id/btn3"
            style="@style/BtnNumber"
            android:text="3"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <Button
            android:id="@+id/btnAdd"
            style="@style/BtnOperator"
            android:text="+"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <!-- Row 5: ⌫, 0, ., = -->
        <Button
            android:id="@+id/btnBackspace"
            style="@style/BtnFunction"
            android:text="⌫"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <Button
            android:id="@+id/btn0"
            style="@style/BtnNumber"
            android:text="0"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <Button
            android:id="@+id/btnDot"
            style="@style/BtnNumber"
            android:text="."
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <Button
            android:id="@+id/btnEquals"
            style="@style/BtnEquals"
            android:text="="
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
